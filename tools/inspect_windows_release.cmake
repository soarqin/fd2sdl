# Windows Release发布取证：使用CMake的PE依赖解析，不推断运行库或复制系统DLL。
cmake_minimum_required(VERSION 3.24)
if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()
if(NOT WIN32 OR NOT EXISTS "${FD2_RELEASE_EXE}" OR
   NOT EXISTS "${FD2_DUMPBIN}" OR NOT DEFINED FD2_RELEASE_OUTPUT)
    message(FATAL_ERROR "Provide the actual Windows executable, dumpbin and a new output path")
endif()
get_filename_component(fd2_output_parent "${FD2_RELEASE_OUTPUT}" DIRECTORY)
if(NOT IS_DIRECTORY "${fd2_output_parent}" OR EXISTS "${FD2_RELEASE_OUTPUT}")
    message(FATAL_ERROR "Output must be new with an existing parent")
endif()
file(REAL_PATH "${fd2_output_parent}" fd2_output_parent)
string(TOLOWER "${fd2_output_parent}" fd2_output_lower)
file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/../original_game" fd2_original)
string(TOLOWER "${fd2_original}" fd2_original_lower)
string(FIND "${fd2_output_lower}/" "${fd2_original_lower}/" fd2_original_prefix)
if(fd2_output_lower MATCHES "(^|/)original_game(/|$)" OR fd2_original_prefix EQUAL 0)
    message(FATAL_ERROR "Output cannot be inside original_game")
endif()
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "dumpbin")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${FD2_DUMPBIN}")
file(TO_CMAKE_PATH "$ENV{SystemRoot}/System32" fd2_system_directory)
file(GLOB fd2_system_dlls "${fd2_system_directory}/*.dll")
# 仅支持本项目已用的八项 UCRT 合约；其它虚拟合约保守报告未解决。
set(fd2_api_patterns "")
set(fd2_api_supported "")
foreach(fd2_contract IN ITEMS stdio heap runtime convert environment string math locale)
    list(APPEND fd2_api_supported "api-ms-win-crt-${fd2_contract}-l1-1-0.dll")
    list(APPEND fd2_api_patterns "^api-ms-win-crt-${fd2_contract}-l1-1-0\\.dll$")
endforeach()
if(NOT EXISTS "${fd2_system_directory}/ucrtbase.dll")
    message(FATAL_ERROR "The supported UCRT API contracts require actual System32/ucrtbase.dll")
endif()
# 系统组件是平台前置；不继续递归其可选的Azure/隔离环境等内部依赖。
execute_process(COMMAND "${FD2_DUMPBIN}" /DEPENDENTS "${FD2_RELEASE_EXE}"
    RESULT_VARIABLE fd2_dump_result OUTPUT_VARIABLE fd2_dump_output ERROR_VARIABLE fd2_dump_error)
if(NOT fd2_dump_result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect direct PE imports: ${fd2_dump_error}")
endif()
string(REPLACE "\r" "" fd2_dump_output "${fd2_dump_output}")
string(REPLACE "\n" ";" fd2_dump_lines "${fd2_dump_output}")
set(fd2_direct_imports "")
set(fd2_api_set_contracts "")
foreach(fd2_line IN LISTS fd2_dump_lines)
    string(STRIP "${fd2_line}" fd2_line)
    if(fd2_line MATCHES "^[A-Za-z0-9_.-]+\\.[dD][lL][lL]$")
        list(APPEND fd2_direct_imports "${fd2_line}")
        string(TOLOWER "${fd2_line}" fd2_import_lower)
        if(fd2_import_lower IN_LIST fd2_api_supported)
            list(APPEND fd2_api_set_contracts "${fd2_import_lower}")
        endif()
    endif()
endforeach()
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${FD2_RELEASE_EXE}"
    DIRECTORIES ${FD2_DEPENDENCY_DIRECTORIES}
    RESOLVED_DEPENDENCIES_VAR fd2_resolved
    UNRESOLVED_DEPENDENCIES_VAR fd2_unresolved
    PRE_EXCLUDE_REGEXES ${fd2_api_patterns}
    POST_EXCLUDE_FILES ${fd2_system_dlls})
set(fd2_report "{}")
string(JSON fd2_report SET "${fd2_report}" schema "\"fd2-windows-runtime-dependencies-v1\"")
string(JSON fd2_report SET "${fd2_report}" system_directory "\"${fd2_system_directory}\"")
file(REAL_PATH "${FD2_RELEASE_EXE}" fd2_executable)
file(SHA256 "${fd2_executable}" fd2_executable_sha256)
string(JSON fd2_report SET "${fd2_report}" executable "\"${fd2_executable}\"")
string(JSON fd2_report SET "${fd2_report}" executable_sha256 "\"${fd2_executable_sha256}\"")
string(JSON fd2_report SET "${fd2_report}" backing_runtime "\"${fd2_system_directory}/ucrtbase.dll\"")
foreach(fd2_kind IN ITEMS resolved unresolved direct_imports api_supported api_set_contracts)
    set(fd2_array "[]")
    set(fd2_index 0)
    foreach(fd2_entry IN LISTS fd2_${fd2_kind})
        file(TO_CMAKE_PATH "${fd2_entry}" fd2_path)
        string(JSON fd2_array SET "${fd2_array}" ${fd2_index} "\"${fd2_path}\"")
        math(EXPR fd2_index "${fd2_index}+1")
    endforeach()
    string(JSON fd2_report SET "${fd2_report}" ${fd2_kind} "${fd2_array}")
endforeach()
file(WRITE "${FD2_RELEASE_OUTPUT}" "${fd2_report}\n")
if(fd2_unresolved)
    message(FATAL_ERROR "Unresolved runtime dependencies remain; see ${FD2_RELEASE_OUTPUT}")
endif()
